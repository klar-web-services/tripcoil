{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "findings", "coverageNotes", "actions"],
  "properties": {
    "summary": {"type": "string"},
    "coverageNotes": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "verdict", "exploitability", "priority", "reasoning", "evidence", "fix", "sources", "corrections", "item", "vulnerability"],
        "properties": {
          "findingId": {"type": "string"},
          "verdict": {"type": "string", "enum": ["confirmed", "corrected", "false_positive", "added"]},
          "exploitability": {"type": ["string", "null"], "enum": ["exploitable", "conditional", "not_exploitable", "unknown", null]},
          "priority": {"type": ["string", "null"], "enum": ["now", "soon", "scheduled", "none", null]},
          "reasoning": {"type": "string"},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "fix": {"type": "array", "items": {"type": "string"}},
          "sources": {"type": "array", "items": {"type": "string"}},
          "corrections": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["field", "old", "new", "why"],
            "properties": {"field": {"type": "string"}, "old": {"type": "string"}, "new": {"type": "string"}, "why": {"type": "string"}}}},
          "item": {"type": ["string", "null"]},
          "vulnerability": {"type": ["string", "null"]}
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "title", "changes", "also", "steps", "upstream", "why"],
        "properties": {
          "action": {"type": "string"},
          "title": {"type": "string"},
          "changes": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "from", "to"],
            "properties": {"name": {"type": "string"}, "from": {"type": "string"}, "to": {"type": ["string", "null"]}}}},
          "also": {"type": "array", "items": {"type": "string"}},
          "steps": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "command"],
            "properties": {"text": {"type": "string"}, "command": {"type": ["string", "null"]}}}},
          "upstream": {
            "type": "object", "additionalProperties": false,
            "required": ["state", "note", "source"],
            "properties": {"state": {"type": "string", "enum": ["available", "none", "unknown"]}, "note": {"type": "string"}, "source": {"type": ["string", "null"]}}},
          "why": {"type": "string"}
        }
      }
    }
  }
}
